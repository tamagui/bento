{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "types": [
      "node",
      "react"
    ],
    "allowJs": false,
    "declaration": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "theme.ts",
    "example/**/*.ts",
    "example/**/*.tsx",
    "tamagui.config.ts"
  ],
  "exclude": [
    "test",
    "types",
    "node_modules",
    "dist",
    "**/__tests__"
  ]
}

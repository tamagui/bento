{
  "name": "@tamagui/bento",
  "version": "1.138.0",
  "description": "Premium Tamagui components library",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/tamagui/bento.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "sideEffects": [
    "*.css"
  ],
  "source": "index.jsx",
  "types": "./src",
  "main": "index.ts",
  "module": "dist/esm",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "react-native": {
        "import": "./dist/esm/index.native.js",
        "require": "./dist/cjs/index.native.js"
      },
      "types": "./src/index.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/cjs/index.native.js"
    },
    "./data": {
      "react-native": {
        "import": "./dist/esm/data.native.js",
        "require": "./dist/cjs/data.native.js"
      },
      "types": "./src/data.ts",
      "import": "./dist/esm/data.mjs",
      "require": "./dist/cjs/data.cjs"
    },
    "./component/*": {
      "react-native": {
        "import": "./dist/esm/components/*.native.js",
        "require": "./dist/cjs/components/*.native.js"
      },
      "types": "./src/components/*.d.ts",
      "import": "./dist/esm/components/*.mjs",
      "require": "./dist/cjs/components/*.cjs"
    }
  },
  "scripts": {
    "build": "tamagui-build --skip-types",
    "watch": "tamagui-build --skip-types --watch",
    "clean": "tamagui-build clean",
    "build:bento": "node scripts/build-bento.cjs",
    "upload:bento": "node scripts/upload-bento.cjs",
    "dev": "yarn dev:web",
    "dev:web": "DISABLE_EXTRACTION=true NODE_ENV=development webpack serve",
    "dev:web:prod": "NODE_ENV=production webpack serve",
    "dev:web:extract": "DISABLE_EXTRACTION=false NODE_ENV=development webpack serve",
    "dev:native": "EXPO_NO_TELEMETRY=true expo start --dev-client",
    "start": "EXPO_NO_TELEMETRY=true expo start --dev-client",
    "start:extract": "TAMAGUI_OPTIMIZE_NATIVE_VIEWS=1 TAMAGUI_ENABLE_DYNAMIC_LOAD=1 yarn start",
    "start:prod": "DISABLE_EXTRACTION=false TAMAGUI_ENABLE_DYNAMIC_LOAD=1 expo start --dev-client --offline --no-dev --minify",
    "start:android": "yarn start --android",
    "start:clean": "watchman watch-del-all & rm -r $TMPDIR/metro-cache & yarn start -c",
    "android": "EXPO_NO_TELEMETRY=true yarn expo run:android",
    "ios": "EXPO_NO_TELEMETRY=true yarn expo run:ios",
    "web": "EXPO_NO_TELEMETRY=true yarn expo start --web",
    "prod:web": "NODE_ENV=production webpack --json=dist/compilation-stats.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "~3.10.0",
    "@ngneat/falso": "~7.4.0",
    "@rehookify/datepicker": "~6.6.8",
    "@tamagui/colors": "~1.138.0",
    "@tamagui/config": "~1.138.0",
    "@tamagui/font-inter": "~1.138.0",
    "@tamagui/lucide-icons": "~1.138.0",
    "@tamagui/shorthands": "~1.138.0",
    "@tamagui/themes": "~1.138.0",
    "@tamagui/toast": "~1.138.0",
    "@tamagui/use-store": "~1.138.0",
    "@tanstack/react-table": "~8.21.3",
    "@vxrn/color-scheme": "*",
    "awesome-phonenumber": "~6.12.0",
    "expo": "~54.0.23",
    "expo-document-picker": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-dropzone": "~14.3.8",
    "react-hook-form": "~7.66.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "solito": "~4.4.1",
    "tamagui": "~1.138.0",
    "zod": "~3.25.67"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.10",
    "@react-navigation/native": "~7.1.20",
    "@react-navigation/native-stack": "~7.6.3",
    "@supabase/supabase-js": "^2.39.0",
    "@tamagui/babel-plugin": "^1.138.0",
    "@tamagui/build": "^1.138.0",
    "@tamagui/cli": "~1.138.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "acorn": "^8.11.3",
    "acorn-walk": "^8.3.2",
    "archiver": "^6.0.1",
    "css-loader": "^6.7.4",
    "dotenv": "^16.3.1",
    "esbuild-loader": "^4.2.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "html-webpack-plugin": "^5.5.0",
    "metro-runtime": "*",
    "mini-css-extract-plugin": "^2.9.1",
    "tamagui-loader": "^1.138.0",
    "tilg": "0.1.1",
    "typescript": "~5.9.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.8.1"
  }
}
